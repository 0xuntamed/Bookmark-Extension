{
  "manifest_version": 3,
  "name": "Bookmark Notes",
  "version": "1.0.0",
  "description": "Manage Chrome bookmarks with personal notes and saved text snippets.",
  "permissions": [
    "activeTab",
    "bookmarks",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Bookmark Notes"
  }
}
